# =============================================================================
# KickLeague Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# Variables marked [required] must be set for the app to function.
# Variables marked [optional] enable additional features when present.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# [required] PostgreSQL connection string (Neon serverless recommended).
# Source: Neon Console > Project > Connection Details > Connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/kickleague?sslmode=require


# -----------------------------------------------------------------------------
# API-Football (primary data source)
# -----------------------------------------------------------------------------

# [required] RapidAPI key for API-Football v3.
# Source: https://rapidapi.com/api-sports/api/api-football → Subscribe → Apps → Security → Key
API_FOOTBALL_KEY=your-api-football-key


# -----------------------------------------------------------------------------
# The Odds API
# -----------------------------------------------------------------------------

# [required] API key for live betting odds.
# Source: https://the-odds-api.com → Dashboard → API Key
ODDS_API_KEY=your-odds-api-key


# -----------------------------------------------------------------------------
# Site URL
# -----------------------------------------------------------------------------

# [required] Canonical public URL used in SEO metadata, sitemap, and OG images.
# Use your production domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kickleague.com


# -----------------------------------------------------------------------------
# Sentry (error tracking and performance monitoring)
# -----------------------------------------------------------------------------

# [required] Client-side Sentry DSN.
# Source: Sentry > Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# [required] Server-side Sentry DSN (typically the same value as above).
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# [required] Auth token for source map uploads during build.
# Source: Sentry > Settings > Auth Tokens → Create New Token (org:read, project:releases, project:write)
SENTRY_AUTH_TOKEN=sntrys_eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [required] Sentry organization slug.
# Source: Sentry > Settings > General > Organization Slug
SENTRY_ORG=your-org-slug

# [required] Sentry project slug.
# Source: Sentry > Settings > Projects > [project] > Project Slug
SENTRY_PROJECT=your-project-slug


# -----------------------------------------------------------------------------
# QStash (Upstash cron scheduling)
# -----------------------------------------------------------------------------

# [required for setup script] QStash API token for creating schedules.
# Source: Upstash Console > QStash > Settings > Request Token
# Used by: npm run setup-qstash
QSTASH_TOKEN=your-qstash-token

# [required] Signing keys for verifying QStash webhook signatures at runtime.
# Source: Upstash Console > QStash > Signing Keys
QSTASH_CURRENT_SIGNING_KEY=sig_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
QSTASH_NEXT_SIGNING_KEY=sig_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# -----------------------------------------------------------------------------
# Vercel Cron
# -----------------------------------------------------------------------------

# [required] Bearer token for authenticating Vercel cron route requests.
# Generate a random string and set it in both .env.local and Vercel env vars.
# Example: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret


# -----------------------------------------------------------------------------
# Google AdSense (display ads)
# -----------------------------------------------------------------------------

# [optional] AdSense publisher ID. Ads are hidden when not set.
# Source: Google AdSense > Account > Account Information > Publisher ID
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# [optional] Ad unit slot IDs for each placement.
# Source: Google AdSense > Ads > By ad unit > Create ad unit → copy data-ad-slot value
NEXT_PUBLIC_AD_SLOT_HOMEPAGE_TOP=
NEXT_PUBLIC_AD_SLOT_HOMEPAGE_BOTTOM=
NEXT_PUBLIC_AD_SLOT_MATCHES_TOP=
NEXT_PUBLIC_AD_SLOT_MATCHES_BOTTOM=
NEXT_PUBLIC_AD_SLOT_MATCH_DETAIL_1=
NEXT_PUBLIC_AD_SLOT_MATCH_DETAIL_2=
NEXT_PUBLIC_AD_SLOT_TEAM_DETAIL_1=
NEXT_PUBLIC_AD_SLOT_TEAM_DETAIL_2=


# -----------------------------------------------------------------------------
# Affiliate Programs (optional, for monetisation)
# -----------------------------------------------------------------------------
# These IDs are appended to outbound bookmaker links for revenue tracking.
# Sign up for each program, get approved, then copy your ID/btag.

# [optional] Paddy Power affiliate ID. Source: Flutter Partners dashboard
PADDY_POWER_AFF_ID=

# [optional] Entain btag (shared for Coral + Ladbrokes). Source: Entain Partners dashboard
ENTAIN_BTAG=

# [optional] Kindred affiliate ID (Unibet). Source: Kindred Affiliates dashboard
KINDRED_AFF_ID=

# [optional] 888sport affiliate ID. Source: 888 Affiliates dashboard
888_AFF_ID=

# [optional] William Hill btag. Source: William Hill Affiliates dashboard
WILLIAM_HILL_BTAG=


# -----------------------------------------------------------------------------
# Development Overrides
# -----------------------------------------------------------------------------

# [optional] Force geo-detection country code for local development.
# Bypasses IP-based detection. Use ISO 3166-1 alpha-2 codes (e.g. GB, DE, ES).
OVERRIDE_COUNTRY=GB


# -----------------------------------------------------------------------------
# Deployment (used by scripts, not the app itself)
# -----------------------------------------------------------------------------

# [optional] Deployment URL for QStash setup script.
# Falls back to VERCEL_URL (auto-set by Vercel) or localhost:3000.
# Example: https://your-app.vercel.app
# DEPLOY_URL=
